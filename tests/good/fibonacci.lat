int fibonacci(int n) {
    if (n == 0) {
        return 0;
    } else {
        if (n == 1) {
            return 1;
        } else {
            return fibonacci(n - 1) + fibonacci(n - 2);
        } fi
    } fi
}


int main() {
    int n = 0;
    while (true) {
        print(fibonacci(n));
        print("\n");
        n = n + 1;
    }
}
